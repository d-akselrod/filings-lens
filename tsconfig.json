{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/app/*"
      ]
    }
  },
  "include": [
    "src",
    "pipeline",
    "server",
    "api",
    "scripts",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
