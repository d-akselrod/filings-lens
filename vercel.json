{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/status.ts": { "maxDuration": 10 },
    "api/embed.ts": { "maxDuration": 30 },
    "api/answer.ts": { "maxDuration": 300, "includeFiles": "public/data/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    { "source": "/data/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/v/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*).data", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=x-user-defined" }] }
  ]
}
